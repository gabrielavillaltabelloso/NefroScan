<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://tools.android.com/tools">

    <!-- Permisos de Red y Conectividad (Sincronización Firebase Cloud) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permisos de lectura de almacenamiento y multimedia -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".NefroScanApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NefroScan"
        tools:targetApi="34">

        <!-- 0. Pantalla de Autenticación / Login (Nuevo Punto de inicio / LAUNCHER) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 1. Pantalla de Selección de Roles -->
        <activity
            android:name=".RolSelectorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 2. Dashboard / Menú Principal del Promotor de Salud -->
        <activity
            android:name=".PromotorDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 3. Gestor de Sincronización de Fichas (Offline / Cloud) -->
        <activity
            android:name=".SyncStatusActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4. Pantalla de Registro de Paciente -->
        <activity
            android:name=".RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 5. Pantalla de Historial Clínico (Acceso Paciente / Médico) -->
        <activity
            android:name=".HistorialActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 6. Pantalla de Tamizaje Comunitario (Acceso Promotor de Salud) -->
        <activity
            android:name=".PromotorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 7. Pantalla de Mapa de Calor Epidemiológico -->
        <activity
            android:name=".MapaRiesgoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Pantalla principal de Escaneo 3D e IA (Acceso Médico) -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 9. Asistente Virtual / Chatbot IA de Salud Renal -->
        <activity
            android:name=".ChatbotActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 10. Dashboard / Centro de Mando del Médico -->
        <activity
            android:name=".MedicoDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 11. Portal de Autogestión del Paciente -->
        <activity
            android:name=".PacienteDashboardActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 12. Guía de Cuidado Renal y Nutrición Preventiva -->
        <activity
            android:name=".KidneyCareGuideActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>