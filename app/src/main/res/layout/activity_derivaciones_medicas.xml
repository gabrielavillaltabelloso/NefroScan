<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090D16"
    android:fitsSystemWindows="true"
    android:padding="20dp"
    tools:ignore="HardcodedText,VisualLintTextFieldSize,VisualLintButtonSize">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Casos Derivados y Trazabilidad Médica"
        android:textColor="#34D399"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Formulario de derivación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#131B2E"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <EditText
            android:id="@+id/etPacienteDerivacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="#0B1120"
            android:paddingHorizontal="14dp"
            android:hint="Nombre del Paciente"
            android:inputType="textPersonName"
            android:importantForAutofill="no"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etMotivoDerivacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="#0B1120"
            android:paddingHorizontal="14dp"
            android:hint="Motivo (ej. PA > 160/100, Proteinuria +++)"
            android:inputType="text"
            android:importantForAutofill="no"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etCentroSalud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:background="#0B1120"
            android:paddingHorizontal="14dp"
            android:hint="Centro de Salud / Unidad Comunitaria"
            android:inputType="textPostalAddress"
            android:importantForAutofill="no"
            android:textColorHint="#64748B"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCrearDerivacion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Generar Derivación Clínica"
            android:backgroundTint="#059669"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trazabilidad de Pacientes Remitidos"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Lista de derivaciones activas">

        <LinearLayout
            android:id="@+id/layoutContenedorDerivaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>