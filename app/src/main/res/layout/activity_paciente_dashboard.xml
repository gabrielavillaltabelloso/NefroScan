<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal del Paciente"
            android:textColor="#EC4899"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NefroScan - Autogestión Renal"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="20dp"/>

        <!-- Tarjeta Perfil Paciente -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvNombrePacientePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando Paciente..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEdadSexoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edad: -- | Sexo: --"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#334155"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvEstadioERCPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Evaluando datos..."
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnMiHistorial"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Mi Historial y Expedientes"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAsistenteIA"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Asistente Virtual (Chatbot IA)"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnPasaporteQR"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Pasaporte Clínico Digital (QR)"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnGuiaRenal"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Guía de Cuidado y Nutrición"
            android:backgroundTint="#8B5CF6"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnVolverRolesPaciente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cambiar de Perfil"
            android:backgroundTint="#334155"
            android:textColor="#94A3B8" />

    </LinearLayout>
</ScrollView>