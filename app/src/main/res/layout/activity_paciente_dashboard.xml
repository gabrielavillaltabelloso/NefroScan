<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CAF0F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Encabezado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal del Paciente"
            android:textColor="#03045E"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NefroScan · Autogestión Renal"
            android:textColor="#0077B6"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- Tarjeta Perfil Paciente -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#90E0EF"
            app:strokeWidth="1dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvNombrePacientePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando Paciente..."
                    android:textColor="#03045E"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEdadPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edad: --"
                    android:textColor="#0077B6"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#90E0EF"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvEstadioERCPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Evaluando datos..."
                    android:textColor="#00B4D8"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de Acceso Rápido -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerDetalles"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Ver Detalles del Último Diagnóstico"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#03045E"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMiHistorial"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Mi Historial y Expedientes"
            android:textColor="#0077B6"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#0077B6"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsistenteIA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Asistente Virtual (Chatbot IA)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#0077B6"
            android:layout_marginBottom="12dp" />

        <!-- Sección de Herramientas de Autocuidado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Herramientas de Autocuidado"
            android:textColor="#03045E"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordatorioMedicamentos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recordatorio\nMedicamentos"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#00B4D8"
                android:layout_marginEnd="6dp"
                android:padding="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculadoraHidratacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Calculadora\nHidratación"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#0077B6"
                android:layout_marginStart="6dp"
                android:padding="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConsejosRapidos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Consejos\nRápidos"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#03045E"
                android:layout_marginEnd="6dp"
                android:padding="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLineaAyuda"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Línea de\nAyuda"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="12dp"
                app:backgroundTint="#00B4D8"
                android:layout_marginStart="6dp"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Botones principales restantes -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasaporteQR"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pasaporte Clínico Digital (QR)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#00B4D8"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuiaRenal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guía de Cuidado y Nutrición"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#03045E"
            android:layout_marginBottom="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverRolesPaciente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cambiar de Perfil"
            android:textColor="#0077B6"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:backgroundTint="#FFFFFF"
            app:strokeColor="#0077B6"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>