<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Encabezado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal del Paciente"
            android:textColor="#EC4899"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NefroScan • Autogestión Renal"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="24dp"/>

        <!-- Tarjeta Perfil Paciente -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#1E293B"
            app:strokeColor="#334155"
            app:strokeWidth="1dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvNombrePacientePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargando Paciente..."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEdadSexoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edad: -- | Sexo: --"
                    android:textColor="#94A3B8"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#334155"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tvEstadioERCPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Evaluando datos..."
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botones Principales -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMiHistorial"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Mi Historial y Expedientes"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#1E293B"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAsistenteIA"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Asistente Virtual (Chatbot IA)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#0284C7"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPasaporteQR"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Pasaporte Clínico Digital (QR)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#10B981"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGuiaRenal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guía de Cuidado y Nutrición"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="16dp"
            app:backgroundTint="#8B5CF6"
            android:layout_marginBottom="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverRolesPaciente"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cambiar de Perfil"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:backgroundTint="#334155" />

    </LinearLayout>
</ScrollView>