<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1120"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp"
    tools:ignore="HardcodedText,VisualLintButtonSize,VisualLintTextFieldSize">

    <!-- Título Principal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:text="Rutas y Citas de Control ERC"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Contenedor del Formulario -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#131B2E"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#1E293B"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Campo: Nombre del Paciente -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="Nombre del Paciente"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#0B1120"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="#38BDF8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="#38BDF8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreVisita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Campo: Comunidad / Dirección -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Comunidad / Dirección"
                android:textColorHint="#64748B"
                app:boxBackgroundColor="#0B1120"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeColor="#38BDF8"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1.5dp"
                app:hintTextColor="#38BDF8">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLugarVisita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPostalAddress"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón Agendar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAgendar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:backgroundTint="#0284C7"
                android:text="Agendar Visita"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:rippleColor="#38BDF8" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Subtítulo de la Lista -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Visitas Programadas"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Contenedor de Scroll para la Lista -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Lista de visitas agendadas"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutContenedorVisitas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>