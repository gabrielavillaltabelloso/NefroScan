<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- CABECERA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Simulador Hemodinámico Renal"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gemelo Digital • Respuesta Terapéutica Inmediata"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCerrarSimulador"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:icon="@android:drawable/ic_menu_close_clear_cancel"
                app:backgroundTint="#334155" />
        </LinearLayout>

        <!-- TARJETA DE PROYECCIÓN DE IMPACTO CLÍNICO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reserva Funcional Glomerular Estimada"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:weightSum="2">

                    <!-- Indicador 5 Años -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="eGFR a 5 años"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSimEgfr5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="68 mL/min"
                            android:textColor="#38BDF8"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Indicador 10 Años -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="#0F172A"
                        android:padding="12dp"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="eGFR a 10 años"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvSimEgfr10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="52 mL/min"
                            android:textColor="#10B981"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDiagnosticoSimulacion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: Riesgo Estable / Preservación Tubular Adecuada"
                    android:textColor="#10B981"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA DE CONTROLES TERAPÉUTICOS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#1E293B"
            app:cardElevation="6dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Variables Clínicas &amp; Hábitos de Campo"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <!-- Control 1: Ingesta Hídrica -->
                <TextView
                    android:id="@+id/lblSimAgua"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meta de Hidratación: 2.5 L/día"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSimAgua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"
                    android:progress="25"
                    android:progressTint="#38BDF8"
                    android:thumbTint="#38BDF8"
                    android:layout_marginBottom="14dp" />

                <!-- Control 2: Nivel de Sodio -->
                <TextView
                    android:id="@+id/lblSimSodio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consumo de Sodio: Normal (1.5g - 2.3g/día)"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSimSodio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="2"
                    android:progress="1"
                    android:progressTint="#F59E0B"
                    android:thumbTint="#F59E0B"
                    android:layout_marginBottom="14dp" />

                <!-- Control 3: Presión Sistólica -->
                <TextView
                    android:id="@+id/lblSimPresion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Presión Arterial Sistólica: 125 mmHg"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/sbSimPresion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="35"
                    android:progressTint="#EF4444"
                    android:thumbTint="#EF4444" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN DE APLICAR RECETA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportarProtocolo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar Protocolo Terapéutico en Ficha"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:backgroundTint="#0284C7" />

    </LinearLayout>
</ScrollView>