<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true"
    android:padding="20dp"
    tools:ignore="HardcodedText,VisualLintTextFieldSize,VisualLintButtonSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="Ficha de Tamizaje Comunitario"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Evaluación de Riesgo Ocupacional y Renal"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Nombre del Paciente -->
        <EditText
            android:id="@+id/etPromotorNombre"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="#131B2E"
            android:hint="Nombre Completo del Habitante"
            android:importantForAutofill="no"
            android:inputType="textPersonName"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <!-- Presión Arterial Sistólica -->
        <EditText
            android:id="@+id/etPromotorPA"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:background="#131B2E"
            android:hint="Presión Sistólica (Ej: 120 o 150)"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <!-- Presión Arterial Diastólica -->
        <EditText
            android:id="@+id/etPromotorPADiastolica"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="#131B2E"
            android:hint="Presión Diastólica (Ej: 80 o 95)"
            android:importantForAutofill="no"
            android:inputType="number"
            android:paddingHorizontal="16dp"
            android:textColor="#F8FAFC"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <!-- Selector de Antecedente Agrícola / Laboral -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="¿Trabajo agrícola intenso / exposición a calor extremo?"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerExposicion"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="18dp"
            android:background="#131B2E"
            android:paddingHorizontal="12dp" />

        <!-- Selector de Síntomas de Alerta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Signos de Alerta Observados en Visita:"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinnerSintomasAlerta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="28dp"
            android:background="#131B2E"
            android:paddingHorizontal="12dp" />

        <!-- Botón de Análisis de Campo -->
        <Button
            android:id="@+id/btnCalcularRiesgoCampo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#0284C7"
            android:text="Calcular Semáforo de Riesgo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Botón para Derivar Directamente al Médico -->
        <Button
            android:id="@+id/btnDerivarCasoDirecto"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#0F766E"
            android:text="Derivar Caso a Médico (Teleapoyo)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>