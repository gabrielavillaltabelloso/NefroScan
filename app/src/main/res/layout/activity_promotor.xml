<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ficha de Tamizaje Comunitario"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Evaluación de Riesgo Ocupacional y Renal"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- Nombre del Paciente -->
        <EditText
            android:id="@+id/etPromotorNombre"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:hint="Nombre Completo del Habitante"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="textPersonName"/>

        <!-- Presión Arterial Sistólica -->
        <EditText
            android:id="@+id/etPromotorPA"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:hint="Presión Sistólica (Ej: 120 o 150)"
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:inputType="number"/>

        <!-- Selector de Antecedente Agrícola / Laboral -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Trabajo agrícola intenso / exposición a calor extremo?"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <Spinner
            android:id="@+id/spinnerExposicion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- Botón de Análisis de Campo -->
        <Button
            android:id="@+id/btnCalcularRiesgoCampo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Calcular Semáforo de Riesgo"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>