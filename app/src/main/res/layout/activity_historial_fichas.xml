<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="20dp"
    tools:ignore="HardcodedText,VisualLintTextFieldSize">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Historial de Fichas Comunitarias"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Barra de búsqueda -->
    <EditText
        android:id="@+id/etBuscarFicha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="#131B2E"
        android:hint="Buscar por paciente o comunidad..."
        android:importantForAutofill="no"
        android:inputType="text"
        android:minHeight="52dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="#F8FAFC"
        android:textColorHint="#64748B"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Evaluaciones Registradas"
        android:textColor="#F8FAFC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Lista scrolleable de fichas -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Lista de fichas comunitarias">

        <LinearLayout
            android:id="@+id/layoutContenedorFichas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>