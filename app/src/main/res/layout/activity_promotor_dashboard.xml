<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panel del Promotor de Salud"
        android:textColor="#38BDF8"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de Visitas Domiciliarias y Campo"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnNuevaVisita"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Nueva Visita / Tamizaje Comunitario"
        android:backgroundTint="#0284C7"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnMapaRiesgo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Radar Epidemiológico Nacional"
        android:backgroundTint="#1E293B"
        android:textColor="#38BDF8"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnEstadoSincronizacion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Sincronización de Fichas (Offline/Cloud)"
        android:backgroundTint="#1E293B"
        android:textColor="#10B981"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnVolverRoles"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Cambiar de Rol"
        android:backgroundTint="#334155"
        android:textColor="#94A3B8"/>

</LinearLayout>