<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Panel del Promotor de Salud"
            android:textColor="#38BDF8"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="Gestión de Visitas Domiciliarias y Campo"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnNuevaVisita"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#0284C7"
            android:text="Tamizaje y Alertas de Riesgo (CKD)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCalendarioVisitas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#1E293B"
            android:text="Rutas y Citas de Control ERC"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnHistorialFichas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#1E293B"
            android:text="Historial de Fichas Comunitarias"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDerivacionesMedicas"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#0F766E"
            android:text="Casos Derivados y Trazabilidad Médica"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChatConsultaRapida"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#4F46E5"
            android:text="Chat de Consulta Rápida (Mensajería Segura)"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRecursosEducativos"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#1E293B"
            android:text="Guías y Educación Comunitaria"
            android:textColor="#F8FAFC"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMapaRiesgo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#1E293B"
            android:text="Radar Epidemiológico Nacional"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEstadoSincronizacion"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E293B"
            android:text="Sincronización (Offline / Cloud)"
            android:textColor="#10B981"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVolverRoles"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#334155"
            android:text="Cambiar de Rol"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>