<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical">

    <!-- Header con sombra y mejor espaciado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        android:elevation="4dp"
        android:background="#1E293B">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Historial de Expedientes"
            android:textColor="#38BDF8"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:fontFamily="sans-serif-medium" />

        <!-- Subtítulo opcional -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Registros locales almacenados"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif" />

        <!-- Separador decorativo -->
        <View
            android:layout_width="40dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:background="#38BDF8"
            android:backgroundTint="#38BDF8" />
    </LinearLayout>

    <!-- Contenedor principal con CardView para el estado vacío -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <!-- Estado vacío mejorado -->
        <LinearLayout
            android:id="@+id/emptyStateLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone"
            android:background="@drawable/empty_state_background"
            android:elevation="2dp">

            <!-- Ícono decorativo -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_empty_folder"
                android:alpha="0.5"
                android:layout_marginBottom="24dp"
                android:contentDescription="Sin registros" />

            <!-- Título de estado vacío -->
            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin registros"
                android:textColor="#E2E8F0"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="sans-serif-medium" />

            <!-- Mensaje de estado vacío -->
            <TextView
                android:id="@+id/tvHistorialEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no se ha almacenado ningún expediente localmente"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:fontFamily="sans-serif" />

            <!-- Botón opcional de acción -->
            <Button
                android:id="@+id/btnStartNew"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear primer registro"
                android:textColor="#FFFFFF"
                android:backgroundTint="#3B82F6"
                android:layout_marginTop="24dp"
                android:paddingHorizontal="24dp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button" />
        </LinearLayout>

        <!-- RecyclerView con margen superior -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="true" />
    </FrameLayout>
</LinearLayout>