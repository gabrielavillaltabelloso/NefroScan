<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:orientation="vertical">

    <!-- Barra superior -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarMapaRiesgo"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#FFFFFF"
            app:navigationIcon="@android:drawable/ic_menu_revert"
            app:title="Vigilancia Epidemiológica"
            app:titleTextColor="#03045E"
            app:titleTextAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            app:subtitle="Mapa de Concentración de Riesgo Renal Comunitario"
            app:subtitleTextColor="#0077B6" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Resumen de zonas críticas para el médico -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen Epidemiológico (Sector Piloto):"
                android:textColor="#EF4444"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvResumenZonasCriticas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sincronizando con base comunitaria..."
                android:textColor="#334155"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Contenedor del mapa Leaflet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <WebView
            android:id="@+id/webViewMapaRiesgo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />

        <ProgressBar
            android:id="@+id/progressBarMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Botón para volver -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverMenu"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_margin="16dp"
        android:text="Regresar al Menú Principal"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#0077B6"
        app:cornerRadius="12dp"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart" />

</LinearLayout>