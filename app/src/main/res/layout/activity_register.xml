<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear Nuevo Perfil"
            android:textColor="#38BDF8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registro individual en el sistema NefroScan"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Selección de Rol -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccione su Rol:"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <Spinner
                    android:id="@+id/spRolRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="#334155"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="16dp"/>

                <!-- Nombre Completo -->
                <EditText
                    android:id="@+id/etNombreRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Nombre Completo"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:background="#334155"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:inputType="textPersonName" />

                <!-- DUI / Correo (ID Unico) -->
                <EditText
                    android:id="@+id/etIdUsuarioRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="DUI o Correo (Será su ID de acceso)"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:background="#334155"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:inputType="textEmailAddress" />

                <!-- Detalle Adicional (Especialidad o Caserío) -->
                <EditText
                    android:id="@+id/etDetalleRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Especialidad médica / Cantón o Caserío"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:background="#334155"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:inputType="text" />

                <!-- Contraseña -->
                <EditText
                    android:id="@+id/etContrasenaRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Contraseña de seguridad"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:background="#334155"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"
                    android:inputType="textPassword" />

                <!-- Botón Guardar Cuenta -->
                <Button
                    android:id="@+id/btnGuardarRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Crear Mi Cuenta e Iniciar"
                    android:backgroundTint="#10B981"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnVolverLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Ya tienes cuenta? Inicia Sesión"
            android:textColor="#38BDF8"
            style="@style/Widget.Material3.Button.TextButton"/>

    </LinearLayout>
</ScrollView>