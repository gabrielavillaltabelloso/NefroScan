<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CAF0F8"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ChatbotActivity">

    <!-- Encabezado del Chatbot -->
    <TextView
        android:id="@+id/tvTituloChatbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:gravity="center"
        android:text="Asistente Virtual NefroScan"
        android:textColor="#03045E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubtituloChatbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="Educación y Orientación en Salud Renal"
        android:textColor="#0077B6"
        android:textSize="12sp" />

    <!-- Lista de Mensajes del Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:clipToPadding="false"
        android:padding="8dp" />

    <!-- Preguntas y Botones de Opciones -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPreguntas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true"
            app:chipSpacingHorizontal="8dp" />

    </HorizontalScrollView>

    <!-- Botón Volver -->
    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#FFFFFF"
        android:text="Volver"
        android:textColor="#0077B6"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout> 