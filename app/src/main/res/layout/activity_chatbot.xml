<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Encabezado del Chatbot -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asistente Virtual NefroScan"
        android:textColor="#38BDF8"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Educacion y Orientacion en Salud Renal"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Lista de Mensajes del Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"/>

    <!-- Área de Entrada de Texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="#1E293B"
            android:hint="Escribe tu consulta sobre salud renal..."
            android:textColorHint="#64748B"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:textSize="14sp"
            android:inputType="textPersonName"/>

        <Button
            android:id="@+id/btnSendChat"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:text="Enviar"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Volver"
        android:backgroundTint="#334155"
        android:textColor="#94A3B8"/>

</LinearLayout>