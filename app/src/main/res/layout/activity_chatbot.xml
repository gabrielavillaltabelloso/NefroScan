<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F9FF"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Encabezado del Chatbot con Icono -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp"
        android:background="@drawable/header_background"
        android:padding="12dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_kidney_health"
            android:contentDescription="Icono de salud renal"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Asistente Virtual NefroScan"
                android:textColor="#0369A1"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tu compañero en el cuidado renal ❤️"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_online_status"
            android:contentDescription="En línea"/>
    </LinearLayout>

    <!-- Mensaje de Bienvenida -->
    <LinearLayout
        android:id="@+id/welcomeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E0F2FE"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👋 ¡Hola! Soy tu asistente virtual"
            android:textColor="#0369A1"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puedo ayudarte con información sobre:\n• Alimentación saludable para tus riñones\n• Comprensión de resultados médicos\n• Consejos de cuidado renal\n• Respuestas a tus dudas frecuentes"
            android:textColor="#334155"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>

    <!-- Lista de Mensajes del Chat -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <!-- Sugerencias Rápidas -->
    <LinearLayout
        android:id="@+id/quickSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="visible">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/suggestion1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="¿Qué puedo comer?"
                    android:background="@drawable/suggestion_chip"
                    android:textColor="#0369A1"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/suggestion2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Entender mis resultados"
                    android:background="@drawable/suggestion_chip"
                    android:textColor="#0369A1"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/suggestion3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Consejos de cuidado"
                    android:background="@drawable/suggestion_chip"
                    android:textColor="#0369A1"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Área de Entrada de Texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/input_background"
        android:padding="4dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Escribe tu consulta aquí..."
            android:textColorHint="#94A3B8"
            android:textColor="#1E293B"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="15sp"
            android:inputType="textMultiLine"
            android:maxLines="4"/>

        <ImageButton
            android:id="@+id/btnAttachFile"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_attach_file"
            android:background="@android:color/transparent"
            android:contentDescription="Adjuntar archivo"
            android:layout_marginEnd="4dp"
            android:tint="#64748B"/>

        <ImageButton
            android:id="@+id/btnSendChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_send_message"
            android:background="@drawable/send_button_background"
            android:contentDescription="Enviar mensaje"
            android:tint="#FFFFFF"/>
    </LinearLayout>

    <!-- Indicador de Escritura -->
    <LinearLayout
        android:id="@+id/typingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="El asistente está escribiendo"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"/>

        <ProgressBar
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:indeterminate="true"
            android:indeterminateTint="#0369A1"/>
    </LinearLayout>

    <!-- Botón de Navegación -->
    <Button
        android:id="@+id/btnVolverHistorial"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Volver al Historial"
        android:textColor="#0369A1"
        android:textSize="14sp"
        android:background="@drawable/back_button_background"
        android:drawableStart="@drawable/ic_arrow_back"
        android:drawablePadding="8dp"
        android:gravity="center"/>

</LinearLayout>