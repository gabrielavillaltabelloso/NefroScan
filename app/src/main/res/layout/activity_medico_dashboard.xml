<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado de la Estación Médica -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consola Diagnóstica Médica"
            android:textColor="#38BDF8"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NefroScan AI • Centro de Mando Nefrológico"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- TARJETA 1: KPIs y Métricas de Diagnóstico -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Métricas de Evaluación Clínica"
                    android:textColor="#38BDF8"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvKpiTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pacientes"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvKpiRiesgoAlto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#EF4444"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Riesgo Alto"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tvKpiPrecisionIA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="94.2%"
                            android:textColor="#10B981"
                            android:textSize="22sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Precisión IA"
                            android:textColor="#94A3B8"
                            android:textSize="11sp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TARJETA 2: Alerta de Derivación del Promotor -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚨 Triaje de Campo (Promotores de Salud)"
                    android:textColor="#F59E0B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:id="@+id/tvAlertaDerivacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comprobando alertas de tamizaje comunitario..."
                    android:textColor="#E2E8F0"
                    android:textSize="13sp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- HERRAMIENTAS Y FUNCIONES CLÍNICAS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Herramientas Clínicas Avanzadas"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón 1: Inferencia Ecográfica, TFLite y Modelo 3D -->
        <Button
            android:id="@+id/btnInferenciaEcografia"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🔬 Nueva Ecografía + IA (TFLite / 3D)"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón 2: Calculadora Médica eGFR CKD-EPI -->
        <Button
            android:id="@+id/btnCalculadoraEgfr"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🧮 Calculadora eGFR (CKD-EPI Clínica)"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón Función Plus 1: Farmacovigilancia y Toxicidad -->
        <Button
            android:id="@+id/btnNefrotoxicidad"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="💊 Evaluador de Nefrotoxicidad por Fármacos"
            android:backgroundTint="#1E293B"
            android:textColor="#EC4899"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón Función Plus 2: Prescriptor de Hidratación por Clima -->
        <Button
            android:id="@+id/btnPrescriptorHidratacion"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="☀️ Prescriptor de Hidratación por Clima / Campo"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón Función Plus 3: Calculadora KFRE Riesgo de Diálisis -->
        <Button
            android:id="@+id/btnCalculadoraKfre"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="📉 Calculadora de Riesgo de Diálisis (KFRE 2/5 años)"
            android:backgroundTint="#1E293B"
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón 3: Generador de Informe Médico / PDF -->
        <Button
            android:id="@+id/btnGenerarInformePdf"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="📄 Exportar Informe Clínico Oficial"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón 4: Expedientes y Revisiones -->
        <Button
            android:id="@+id/btnExpedientesClinicos"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="📋 Expedientes y Revisiones Médicas"
            android:backgroundTint="#1E293B"
            android:textColor="#E2E8F0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <!-- Botón 5: Radar Epidemiológico Nacional -->
        <Button
            android:id="@+id/btnRadarMed"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="🗺️ Radar Epidemiológico Nacional"
            android:backgroundTint="#1E293B"
            android:textColor="#F59E0B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnVolverRolesMed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Volver a Selección de Perfil"
            android:backgroundTint="#334155"
            android:textColor="#94A3B8"/>

    </LinearLayout>
</ScrollView>