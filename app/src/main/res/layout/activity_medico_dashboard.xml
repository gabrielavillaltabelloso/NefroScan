<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:padding="20dp"
    android:scrollbarStyle="outsideOverlay"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- ============================================================ -->
        <!-- BARRA DE ESTADO DEL SISTEMA + NOTIFICACIONES -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            android:paddingHorizontal="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@android:drawable/presence_online"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sistema activo • Sincronizado"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:letterSpacing="0.03" />
            </LinearLayout>

            <!-- Badge de notificaciones -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#64748B"
                    android:alpha="0.8" />

                <TextView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="top|end"
                    android:background="@android:drawable/presence_online"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Indicador de IA activa -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="#1E293B"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@android:drawable/presence_online"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IA activa"
                    android:textColor="#10B981"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ENCABEZADO PREMIUM CON GLASSMORFISMO -->
        <!-- ============================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#E8F4FD"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Avatar médico con marco -->
                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="14dp">

                        <View
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@android:drawable/presence_online"
                            android:layout_gravity="center" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_add"
                            app:tint="#0077B6" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Consola Diagnóstica Médica"
                            android:textColor="#0F172A"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="NefroScan AI • Centro de Mando Nefrológico"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:letterSpacing="0.03"
                            android:layout_marginTop="2dp" />

                        <!-- Chip de ubicación -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="6dp"
                            android:background="#E2E8F0"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@android:drawable/ic_menu_mylocation"
                                app:tint="#0077B6"
                                android:layout_marginEnd="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Hospital Central • Nefrología"
                                android:textColor="#0077B6"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Barra de búsqueda rápida -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#FFFFFF"
                    android:paddingHorizontal="14dp"
                    android:layout_marginTop="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#94A3B8"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Buscar paciente, expediente o estudio..."
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_manage"
                        app:tint="#0077B6" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- KPIs CON ANILLOS DE PROGRESO CIRCULAR -->
        <!-- ============================================================ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="20dp">

            <!-- KPI 1: Total Pacientes -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginBottom="8dp">

                        <ProgressBar
                            android:id="@+id/progressTotal"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="78"
                            android:progressTint="#00B4D8"
                            android:rotation="-90"
                            android:layout_gravity="center" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_myplaces"
                            app:tint="#00B4D8" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvKpiTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,247"
                        android:textColor="#0F172A"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pacientes totales"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:letterSpacing="0.04"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+12 hoy"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- KPI 2: Riesgo Alto -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginBottom="8dp">

                        <ProgressBar
                            android:id="@+id/progressRiesgo"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="23"
                            android:progressTint="#EF4444"
                            android:rotation="-90"
                            android:layout_gravity="center" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_dialog_alert"
                            app:tint="#EF4444" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvKpiRiesgoAlto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="287"
                        android:textColor="#EF4444"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Riesgo Alto"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:letterSpacing="0.04"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="23% del total"
                        android:textColor="#EF4444"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- KPI 3: Precisión IA -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <FrameLayout
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:layout_marginBottom="8dp">

                        <ProgressBar
                            android:id="@+id/progressPrecision"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:indeterminate="false"
                            android:max="100"
                            android:progress="94"
                            android:progressTint="#10B981"
                            android:rotation="-90"
                            android:layout_gravity="center" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@android:drawable/ic_menu_compass"
                            app:tint="#10B981" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvKpiPrecisionIA"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="94.2%"
                        android:textColor="#10B981"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precisión IA"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:letterSpacing="0.04"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v2.4.1 • Optimizada"
                        android:textColor="#10B981"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- ACCIONES RÁPIDAS - CHIPS HORIZONTALES SCROLLEABLES -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acciones rápidas"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:layout_marginBottom="10dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="20dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Chip 1 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#0077B6"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nueva ecografía"
                        android:textColor="#0077B6"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Chip 2 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="#64748B"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calcular eGFR"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Chip 3 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_dialog_info"
                        app:tint="#DB2777"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nefrotoxicidad"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Chip 4 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal"
                    android:layout_marginEnd="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_upload"
                        app:tint="#0EA5E9"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hidratación"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Chip 5 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="#1E293B"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@android:drawable/ic_menu_mapmode"
                        app:tint="#B45309"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Radar Epi."
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ============================================================ -->
        <!-- GRÁFICO DE BARRAS DE DISTRIBUCIÓN (COMPONENTE NATIVO) -->
        <!-- ============================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distribución de Pacientes por Riesgo Renal"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="12dp" />

                <!-- Riesgo Bajo -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riesgo Bajo / Estadio G1-G2"
                    android:textColor="#10B981"
                    android:textSize="11sp"/>
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="65"
                    android:progressTint="#10B981"
                    android:layout_marginBottom="8dp"/>

                <!-- Riesgo Moderado -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riesgo Moderado / Estadio G3a-G3b"
                    android:textColor="#F59E0B"
                    android:textSize="11sp"/>
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="25"
                    android:progressTint="#F59E0B"
                    android:layout_marginBottom="8dp"/>

                <!-- Riesgo Alto -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Riesgo Alto / Estadio G4-G5"
                    android:textColor="#EF4444"
                    android:textSize="11sp"/>
                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="10"
                    android:progressTint="#EF4444"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- ALERTA INTELIGENTE DE TRIAJE -->
        <!-- ============================================================ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFBF5"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp">

                    <View
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@android:drawable/presence_online"
                        android:layout_gravity="center" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_dialog_alert"
                        app:tint="#F59E0B" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Alerta de Tamizaje Comunitario"
                        android:textColor="#92400E"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/tvAlertaDerivacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3 pacientes con eGFR &lt;30 requieren derivación inmediata a nefrología."
                        android:textColor="#A16207"
                        android:textSize="11sp"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ============================================================ -->
        <!-- ACTIVIDAD RECIENTE -->
        <!-- ============================================================ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actividad reciente"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Item 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="10dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@android:drawable/presence_online"
                        android:layout_marginEnd="12dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ecografía analizada por IA"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
