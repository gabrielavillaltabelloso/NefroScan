<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- LOGO Y TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NefroScan AI"
            android:textColor="#38BDF8"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal Clínico y Autogestión Renal"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- TARJETA DE LOGIN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Iniciar Sesión"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- Campo Usuario -->
                <EditText
                    android:id="@+id/etUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="DUI / Usuario (ej: med@nefro.sv)"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:background="#334155"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp"
                    android:inputType="textEmailAddress" />

                <!-- Campo Contraseña -->
                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Contraseña"
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:background="#334155"
                    android:paddingHorizontal="16dp"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"
                    android:inputType="textPassword" />

                <!-- Botón Ingresar -->
                <Button
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Ingresar al Sistema"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN NAVEGACIÓN LIBRE A SELECTOR DE ROLES -->
        <Button
            android:id="@+id/btnSelectorRoles"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Navegación Libre / Probar Selector de Roles"
            android:backgroundTint="#1E293B"
            android:textColor="#38BDF8"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- ACCESOS RÁPIDOS PARA DEMO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Accesos Rápidos para Demo (CIMAT):"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnQuickMedico"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Médico"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#38BDF8"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnQuickPromotor"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Promotor"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#F59E0B"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnQuickPaciente"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Paciente"
                android:textSize="11sp"
                android:backgroundTint="#334155"
                android:textColor="#10B981" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>