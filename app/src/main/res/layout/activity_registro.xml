<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Visita Domiciliaria"
            android:textColor="#03045E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Ficha de tamizaje comunitario y riesgo renal"
            android:textColor="#0077B6"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombre del Paciente -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre del Paciente"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#0077B6"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombrePaciente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DUI / ID -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="DUI / Identificación"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#0077B6"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDuiPaciente"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Presión Sistólica / Diastólica -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:hint="Sistólica"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="#0077B6">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSistolica"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:hint="Diastólica"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="#0077B6">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiastolica"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <!-- Checkboxes de Exposición -->
                <CheckBox
                    android:id="@+id/cbCalorAgricola"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jornada agrícola intensa o calor extremo"
                    android:textColor="#333333" />

                <CheckBox
                    android:id="@+id/cbAgroquimicos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contacto frecuente con agroquímicos"
                    android:textColor="#333333" />

                <CheckBox
                    android:id="@+id/cbAntecedentes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Diagnóstico previo (Diabetes / Hipertensión)"
                    android:textColor="#333333" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botón para Registrar y Notificar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegistrarVisita"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Registrar y Enviar Notificación"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#0077B6"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>